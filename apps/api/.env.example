# Copy to apps/api/.env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=3000

# Local Postgres from docker-compose.yml. In the cloud: the Supabase connection string (set on Render).
DATABASE_URL=postgresql://dermamind:dermamind@localhost:5432/dermamind?schema=public

# Signs access tokens. Min. 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-for-local-dev

# Requests per minute per IP on /v1/auth/*
AUTH_RATE_LIMIT=20

# GET /v1/app-config — the app shows "Zaktualizuj aplikację" below this version.
MIN_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0

# Claude API — only the server talks to it (PLAN.md 5). Leave empty to run without AI: the AI
# endpoints then answer with fixed fallback texts and everything else works the same.
ANTHROPIC_API_KEY=
# Model IDs from https://docs.claude.com/en/docs/about-claude/models (checked 14.10.2026)
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
# AI calls per user per day; cache hits are free
AI_DAILY_LIMIT=30
AI_TIMEOUT_MS=20000
