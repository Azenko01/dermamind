{
  "name": "dermamind",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "import:catalog": "pnpm --filter @dermamind/scripts import:catalog",
    "ai:check": "pnpm --filter @dermamind/scripts ai:check",
    "catalog:import-obf": "pnpm --filter @dermamind/scripts catalog:import-obf",
    "catalog:relink": "pnpm --filter @dermamind/scripts catalog:relink",
    "catalog:import-obf-taxonomy": "pnpm --filter @dermamind/scripts catalog:import-obf-taxonomy",
    "catalog:import-cosing": "pnpm --filter @dermamind/scripts catalog:import-cosing",
    "catalog:unknown-tokens": "pnpm --filter @dermamind/scripts catalog:unknown-tokens",
    "catalog:apply-alias-review": "pnpm --filter @dermamind/scripts catalog:apply-alias-review"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
